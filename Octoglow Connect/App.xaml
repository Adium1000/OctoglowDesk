<Application x:Class="OctoglowSender.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppShellBackgroundBrush" Color="#B8F3F3F6"/>
                    <SolidColorBrush x:Key="DeleteIconBrush" Color="Black"/>
                    <!-- The clock page's lower half - its tabs and what they show - a shade
                         darker than the content layer, towards the navigation pane beside it. -->
                    <SolidColorBrush x:Key="ClockSectionBandBrush" Color="#0A000000"/>
                    <SolidColorBrush x:Key="SuggestionBackgroundBrush" Color="#E8F4FF"/>
                    <SolidColorBrush x:Key="SuggestionForegroundBrush" Color="#122639"/>
                    <SolidColorBrush x:Key="SuggestionBorderBrush" Color="#B7D9F4"/>
                    <SolidColorBrush x:Key="SuggestionAccentBrush" Color="#0B73BC"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppShellBackgroundBrush" Color="#B8141A2A"/>
                    <SolidColorBrush x:Key="DeleteIconBrush" Color="White"/>
                    <SolidColorBrush x:Key="ClockSectionBandBrush" Color="#2E000000"/>
                    <SolidColorBrush x:Key="SuggestionBackgroundBrush" Color="#1A3146"/>
                    <SolidColorBrush x:Key="SuggestionForegroundBrush" Color="#EDF6FF"/>
                    <SolidColorBrush x:Key="SuggestionBorderBrush" Color="#376485"/>
                    <SolidColorBrush x:Key="SuggestionAccentBrush" Color="#78C9FF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppShellBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="DeleteIconBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="ClockSectionBandBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="SuggestionBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="SuggestionForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    <SolidColorBrush x:Key="SuggestionBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    <SolidColorBrush x:Key="SuggestionAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
