<Page x:Class="OctoglowSender.LogsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:OctoglowSender">
    <!-- The same centred column, padding and scrolling as the clock page's other
         tabs, so the cards line up across all of them. A ListView sat its items
         inside its own scroller and its own container padding, which pushed this
         tab's cards in from the edges the rest of the tabs keep to. -->
    <ScrollViewer x:Name="LogsScroller">
        <StackPanel x:Name="LogsColumn" Padding="0,20,0,40">
            <ItemsRepeater x:Name="LogsList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <!-- x:Bind, compiled with the page: {Binding} looks the properties up
                         by reflection, which a Native AOT build doesn't have, and the
                         cards came out empty there. -->
                    <DataTemplate x:DataType="local:ActivityLogEntry">
                        <!-- Laid out as the settings cards are (SettingsCard in
                             ClockNativeSettingsPage.Controls.cs): the icon in the
                             text colour, a title over a secondary description. -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" MinHeight="68">
                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.72" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Time, Mode=OneWay}" Opacity="0.62" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
