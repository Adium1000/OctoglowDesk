<Page x:Class="OctoglowSender.DeskClockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:OctoglowSender"
      Background="Transparent">
    <Page.Resources>
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ScreenLedOnBrush" Color="{ThemeResource SystemAccentColorLight2}" />
        <SolidColorBrush x:Key="ScreenLedOffBrush" Color="#FF73767C" />
    </Page.Resources>
    <Grid x:Name="ClockLayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ClockHeaderRow" Height="Auto" />
            <RowDefinition x:Name="ClockPreviewRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="32,24,32,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PageTitle" Style="{ThemeResource TitleTextBlockStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
<!-- How things stand with the clock. While it is only on the network, it is
                     a button that asks for the clock's account. -->
                <Button x:Name="ConnectionStateCard" Click="ConnectionState_Click"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderThickness="0"
                        CornerRadius="14" Padding="12,6" MinWidth="0" MinHeight="0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="ConnectionStateIcon" FontSize="15" />
                        <TextBlock x:Name="ConnectionStateText" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <!-- The clock's About, in a panel over the page. -->
                <Button x:Name="AboutButton" Click="AboutButton_Click"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderThickness="0"
                        CornerRadius="14" Padding="9,0" MinWidth="34" VerticalAlignment="Stretch">
                    <FontIcon Glyph="&#xE946;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- The live clock stays visible while the section below changes. -->
        <Viewbox x:Name="ClockPreview"
                 Grid.Row="1"
                 Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 MaxWidth="720"
                 Margin="32,28,32,32">
            <Border x:Name="ClockCase" CornerRadius="26" Padding="22,20"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5"
                    Translation="0,0,24">
                <Border.Shadow><ThemeShadow /></Border.Shadow>
                <Grid>
                    <Border x:Name="ScreenPanel" CornerRadius="14" Padding="14,12"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderThickness="0">
                        <Canvas x:Name="ScreenCanvas" Width="640" Height="160"
                                AutomationProperties.Name="Octoglow Clock LED matrix" />
                    </Border>
                    <StackPanel x:Name="ScreenOverlay" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <FontIcon x:Name="ScreenOverlayIcon" FontFamily="Segoe Fluent Icons" FontSize="18"
                                  Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock x:Name="ScreenOverlayText" FontSize="15" FontWeight="SemiBold" Opacity="0.82"
                                   TextWrapping="Wrap" MaxWidth="540" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Viewbox>

        <!-- The tabs and their sections share one band across the page, a shade darker
             than the part above and set off from it by a hairline. -->
        <Grid Grid.Row="2"
              Background="{ThemeResource ClockSectionBandBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Not in a sideways scroller: that moved the selected tab off centre, or half
                 out of view. Short of room, the tabs keep their icons and drop their labels. -->
            <SelectorBar x:Name="ClockNavigation"
                         HorizontalAlignment="Center"
                         Margin="16,10,16,0"
                         SelectionChanged="ClockNavigation_SelectionChanged">
                <SelectorBar.Resources>
                    <!-- The chosen tab in accent text over its accent underline; the others
                         lift slightly under the pointer. -->
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="SelectorBarItemForegroundSelected" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                <StaticResource x:Key="SelectorBarItemForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="SelectorBarItemBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="SelectorBarItemForegroundSelected" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                <StaticResource x:Key="SelectorBarItemForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="SelectorBarItemBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </SelectorBar.Resources>
<!-- Every clock setting, each opened in a panel from here; the one opened
                     first, and so the one on the left. Overview is not a tab any more:
                     it opens from About. -->
                <SelectorBarItem x:Name="ConfigurationItem" Tag="configuration">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE9E9;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="IntegrationsItem" Tag="integrations">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xEA86;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="ActivityItem" Tag="activity">
                    <SelectorBarItem.Icon><SymbolIcon Symbol="Document" /></SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <Frame x:Name="ClockContentFrame" Grid.Row="1" Background="Transparent" />
        </Grid>

        <!-- Invisible drag target over the original hairline. The resize cursor
             advertises that this boundary can be moved without changing its look. -->
        <local:VerticalResizeHandle x:Name="ClockSectionSplitter"
                                    Grid.Row="2"
                                    Height="10"
                                    Margin="0,-5,0,0"
                                    VerticalAlignment="Top"
                                    Canvas.ZIndex="10"
                                    PointerPressed="ClockSectionSplitter_PointerPressed"
                                    PointerMoved="ClockSectionSplitter_PointerMoved"
                                    PointerReleased="ClockSectionSplitter_PointerReleased"
                                    PointerCaptureLost="ClockSectionSplitter_PointerCaptureLost" />
    </Grid>
</Page>
