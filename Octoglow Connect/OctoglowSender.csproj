<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <UseWPF>false</UseWPF>
    <WindowsPackageType>None</WindowsPackageType>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- The audio capture's COM interfaces are generated at compile time (AudioCapture.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The app also publishes as Native AOT (Properties\PublishProfiles\NativeAot.pubxml,
         publish-aot.ps1): these flag, in every build, code that such a build couldn't run. -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\octoglow_logo.ico</ApplicationIcon>
    <AssemblyName>OctoglowConnect</AssemblyName>
    <RootNamespace>OctoglowSender</RootNamespace>
    <Product>Octoglow Connect</Product>
    <Description>Hub pentru dispozitivele Octoglow Clock și Octoglow Macro.</Description>
    <Version>2.0.0</Version>
    <!-- No explicit CsWinRT package/CsWinRTIncludes needed: the net8.0-windows10.0.19041.0
         TFM already ships built-in projections for Windows.Media.Control and
         Windows.UI.Notifications. Forcing CsWinRTIncludes=Windows makes cswinrt.exe try to
         regenerate a projection of the ENTIRE Windows namespace, which requires the UAP
         Platform.xml that only exists if the full UWP Visual Studio workload is installed. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Licenses\**\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\octoglow_logo.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\octoglow_clock.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\octoglow_macro.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\octoglow_logo.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\macropad-nobg.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\smartclock-nobg_2.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Guides\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="BrowserExtension\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251106002" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- WinUI keeps the compiled XAML in OctoglowConnect.pri, which a Native AOT publish
       leaves behind - and without it the app closes as it starts. -->
  <Target Name="PublishXamlResources" AfterTargets="Publish" Condition="Exists('$(OutDir)$(TargetName).pri')">
    <Copy SourceFiles="$(OutDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
