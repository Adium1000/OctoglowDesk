<Page x:Class="OctoglowSender.ClockNativeSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Grid>
        <ScrollViewer x:Name="PageScroller">
            <!-- Centred by CenteredColumn: at most 976 wide, with at least 32 on each side. -->
            <StackPanel x:Name="PageStack" Padding="0,20,0,40">
                <!-- The tab already names the section, so the title and description only show on
                     a page of its own inside it, where the back button needs them. -->
                <Grid x:Name="PageHeader" ColumnSpacing="12" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Shown on a page of its own inside a section, such as one of the appearance pages. -->
                    <Button x:Name="BackButton" Click="Back_Click" Visibility="Collapsed"
                            Padding="10,8" VerticalAlignment="Center"
                            Background="Transparent" BorderBrush="Transparent">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>

                    <FontIcon x:Name="PageIcon" Grid.Column="1" FontSize="24" Margin="0,0,4,0"
                              VerticalAlignment="Center" Visibility="Collapsed" />
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="PageDescription" Opacity="0.72" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Settings apply as soon as they change; this says whether the clock has them yet. -->
                    <StackPanel x:Name="SaveStatusPanel" Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <ProgressRing x:Name="SaveProgress" Width="16" Height="16" IsActive="False" />
                        <FontIcon x:Name="SaveOkBadge" Glyph="&#xE74E;" FontSize="14"
                                  Visibility="Collapsed" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <FontIcon x:Name="SaveFailIcon" Glyph="&#xE7BA;" FontSize="14" Visibility="Collapsed"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="SaveText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.8" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="RefreshButton" Grid.Column="4" Click="Refresh_Click"
                            Padding="10,8" VerticalAlignment="Center"
                            Background="Transparent" BorderBrush="Transparent">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                </Grid>

                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Margin="0,4,0,4" />
                <StackPanel x:Name="ContentHost" Spacing="4" />
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingLayer" Background="Transparent">
            <ProgressRing IsActive="True" Width="34" Height="34" />
        </Grid>
    </Grid>
</Page>
