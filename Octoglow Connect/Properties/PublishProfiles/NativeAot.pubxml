<?xml version="1.0" encoding="utf-8"?>
<!-- Octoglow Connect compiled ahead of time to native code: one OctoglowConnect.exe
     that starts without the .NET runtime installed. Run publish-aot.ps1, which
     also works around the Visual Studio 2026 linker lookup. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishDir>bin\Publish\NativeAot\</PublishDir>
    <!-- The native .pdb (tens of MB) stays in obj for reading crash dumps; it isn't shipped. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
