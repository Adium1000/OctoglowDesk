<Page x:Class="OctoglowSender.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Laid out as the clock's Configurations are: a heading per category, and
         under it one card per setting - its icon, what it is, what it does, and
         the control on the right - in the same centred column. -->
    <Page.Resources>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12,16,12" />
            <Setter Property="MinHeight" Value="68" />
        </Style>
        <Style x:Key="SettingIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="2,28,0,6" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="PageScroller">
        <StackPanel x:Name="PageStack" Padding="0,28,0,40" Spacing="4">
            <StackPanel Spacing="4" Margin="0,0,0,4">
                <TextBlock x:Name="PageTitle" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="PageSubtitle" Opacity="0.68" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Appearance -->
            <TextBlock x:Name="AppearanceHeading" Style="{StaticResource SectionHeading}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingIcon}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ThemeTitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="ThemeDescription" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center">
                        <ComboBoxItem x:Name="ThemeSystemItem" Tag="system" />
                        <ComboBoxItem x:Name="ThemeLightItem" Tag="light" />
                        <ComboBoxItem x:Name="ThemeDarkItem" Tag="dark" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE771;" Style="{StaticResource SettingIcon}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="BackdropTitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="BackdropDescription" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                    <ComboBox x:Name="BackdropBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center">
                        <ComboBoxItem x:Name="BackdropNoneItem" Tag="none" />
                        <ComboBoxItem x:Name="BackdropMicaItem" Tag="mica" />
                        <ComboBoxItem x:Name="BackdropMicaAltItem" Tag="micaalt" />
                        <ComboBoxItem x:Name="BackdropAcrylicItem" Tag="acrylic" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Language -->
            <TextBlock x:Name="LanguageHeading" Style="{StaticResource SectionHeading}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" Style="{StaticResource SettingIcon}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LanguageTitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="LanguageDescription" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center">
                        <ComboBoxItem x:Name="LanguageSystemItem" Tag="system" />
                        <ComboBoxItem Tag="ro">Română</ComboBoxItem>
                        <ComboBoxItem Tag="en">English</ComboBoxItem>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Startup -->
            <TextBlock x:Name="StartupHeading" Style="{StaticResource SectionHeading}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7E8;" Style="{StaticResource SettingIcon}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StartupTitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="StartupDescription" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE921;" Style="{StaticResource SettingIcon}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TrayTitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="TrayDescription" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="TraySwitch" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Navigation -->
            <TextBlock x:Name="NavigationHeading" Style="{StaticResource SectionHeading}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A0;" Style="{StaticResource SettingIcon}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="InlineClockConfigurationTitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="InlineClockConfigurationDescription" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="InlineClockConfigurationSwitch" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Devices -->
            <TextBlock x:Name="DevicesHeading" Style="{StaticResource SectionHeading}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE88E;" Style="{StaticResource SettingIcon}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HideUsbTitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="HideUsbDescription" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="HideUsbSwitch" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE701;" Style="{StaticResource SettingIcon}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HideWifiTitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="HideWifiDescription" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="HideWifiSwitch" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72C;" Style="{StaticResource SettingIcon}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ShowDeviceRefreshTitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="ShowDeviceRefreshDescription" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ShowDeviceRefreshSwitch" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE74D;" Style="{StaticResource SettingIcon}" Foreground="{ThemeResource DeleteIconBrush}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DevicesSettingsTitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="DevicesSettingsDescription" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                    <Button x:Name="ClearDevicesButton" Grid.Column="2" VerticalAlignment="Center"
                            Click="ClearDevices_Click" Foreground="{ThemeResource DeleteIconBrush}" />
                </Grid>
            </Border>

            <!-- Reset -->
            <TextBlock x:Name="ResetHeading" Style="{StaticResource SectionHeading}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE777;" Style="{StaticResource SettingIcon}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="RestoreDefaultsTitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="RestoreDefaultsDescription" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                    <Button x:Name="RestoreDefaultsButton" Grid.Column="2" VerticalAlignment="Center" Click="RestoreDefaults_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
